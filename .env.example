# ==============================================================================
# PulseGuard AI - Production Environment Variables
# Copy this file to .env.local for local development and configure the same
# variables in Vercel Project Settings -> Environment Variables.
# ==============================================================================

# 1. Supabase (Required for Auth, PostgreSQL, RLS & Realtime Dispatch)
# Leave empty until configured. The browser client is initialized only when both values are valid.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional (Recommended for server-side IoT webhook DB ingestion bypassing RLS)
SUPABASE_SERVICE_ROLE_KEY=

# 2. Resend Email Dispatch API (Emergency family/contact Code Blue alerts)
RESEND_API_KEY=
# Optional verified sender email
RESEND_FROM_EMAIL=

# 3. Google Gemini API (Optional live clinical triage guidance for responders)
GEMINI_API_KEY=

# 4. Physical IoT Webhook Authentication (ESP32-S3 OBD-II Pro & PulseBox Hubs)
IOT_WEBHOOK_SECRET=
